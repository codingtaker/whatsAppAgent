<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colors shown before Compose draws; Compose does the rest. -->
    <style name="Theme.PriorityAlert" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PriorityAlert.Alert" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
